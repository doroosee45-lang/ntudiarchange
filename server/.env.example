# Copie ce fichier en .env et adapte les valeurs à ton environnement.

PORT=5000

# MongoDB (défaut : base locale). Ex. Atlas :
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/wedding_invite
MONGO_URI=mongodb://127.0.0.1:27017/wedding_invite

# Compte administrateur (créé/mis à jour via `npm run seed:admin`)
ADMIN_EMAIL=archangentudi1@gmail.com
ADMIN_PASSWORD=Gladys
ADMIN_NAME=Administrateur

# Secret JWT — très long et aléatoire (NE JAMAIS partager/committer en prod)
JWT_SECRET=change-moi-en-une-chaine-longue-et-aleatoire

# Origine(s) autorisées pour CORS. Le port par défaut de Vite (5173) est déjà
# autorisé automatiquement en dev ; utilise cette variable pour ajouter
# d'autres origines (séparées par des virgules) — utile en production.
CLIENT_URL=http://localhost:5173



